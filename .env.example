# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Base URL of this app — must match the port you serve it on.
ORIGIN="http://localhost:5174"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Encrypts OAuth tokens + the AI key at rest (openssl rand -base64 32).
AUTH_TOKEN_SECRET=""

# Google OAuth client — your OWN client, OAuth consent screen in "Testing",
# only scope: https://www.googleapis.com/auth/gmail.readonly
# Exact setup steps: docs/google-oauth.md
# Redirect URI: {ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI endpoint defaults (Settings UI overrides these per user).
# Any OpenAI-compatible endpoint works:
#   OpenAI   AI_BASE_URL="https://api.openai.com/v1"      AI_MODEL="gpt-4o-mini"
#   DeepSeek AI_BASE_URL="https://api.deepseek.com"       AI_MODEL="deepseek-flash"
#   Groq     AI_BASE_URL="https://api.groq.com/openai/v1" AI_MODEL="llama-3.3-70b-versatile"
#   OpenRouter AI_BASE_URL="https://openrouter.ai/api/v1" AI_MODEL="openai/gpt-4o-mini"
#   Ollama   AI_BASE_URL="http://localhost:11434/v1"      AI_MODEL="llama3.2"
AI_BASE_URL=""
AI_KEY=""
AI_MODEL=""
# DeepSeek only: "disabled" turns off thinking mode — faster and cheaper, and
# the reply carries no `reasoning_content`. Leave empty for other providers.
AI_THINKING=""

# TTS defaults: kitten | kokoro | webspeech | google | minimax
# kitten/kokoro/webspeech run in the browser ($0, no key needed).
TTS_ENGINE="kitten"
GOOGLE_TTS_KEY=""
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# npm CDN base for the local TTS engines (Kitten ~57MB / Kokoro ~90MB,
# downloaded once by the browser, then cached), used as `<base>/<pkg>/+esm`.
# Must be jsDelivr-style: esm.sh injects a Node `process` shim and the model
# loader then crashes on fs.mkdirSync. PUBLIC_ = visible to the browser.
PUBLIC_TTS_CDN="https://cdn.jsdelivr.net/npm"
