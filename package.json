{
	"name": "kikitai-monorepo",
	"version": "0.3.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun --filter @kikitai/web build",
		"dev": "vp dev",
		"lint": "vp check",
		"format": "vp fmt . --write",
		"format:check": "vp fmt . --check",
		"prepare": "vp config --no-agent"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vite-plus": "^1.3.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0"
	},
	"packageManager": "bun@1.4.3"
}
